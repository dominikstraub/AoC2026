#!/usr/bin/env bash
set -euo pipefail

YEAR=2026
LAST_DAY=12
REPO_ID="github.com/dominikstraub/AoC2026"
KEYCHAIN_SERVICE="adventofcode-session"

cd "$(dirname "$0")/.."

usage() {
  cat <<EOF
Usage: scripts/new-day [day]       download day 1-$LAST_DAY's input and scaffold it from Day00
                                   (day defaults to today in AoC's time zone)
       scripts/new-day --register  only regenerate Sources/AllChallenges.swift
EOF
}

die() {
  echo "$*" >&2
  exit 1
}

register() {
  local out=Sources/AllChallenges.swift count=0 comma="," path content
  for path in Sources/Day[0-9][0-9].swift; do
    if [[ -e $path ]]; then count=$((count + 1)); fi
  done
  if ((count == 0)); then die "No Sources/DayNN.swift to register."; fi
  # swift-format's default style: trailing comma only in a multi-element literal.
  if ((count == 1)); then comma=""; fi

  content=$(
    echo "// Generated by scripts/new-day from the Sources/DayNN.swift files — don't edit."
    echo "let allChallenges: [any AdventDay] = ["
    for path in Sources/Day[0-9][0-9].swift; do
      echo "  $(basename "$path" .swift)()$comma"
    done
    echo "]"
  )
  if [[ -f $out && "$(cat "$out")" == "$content" ]]; then
    echo "Skipped $out (up to date)"
  else
    printf '%s\n' "$content" >"$out"
    echo "Updated $out"
  fi
}

scaffold() {
  local template=$1 target=$2
  if [[ -e $target ]]; then
    echo "Skipped $target (exists)"
    return
  fi
  # The redirect creates the target even when sed fails; an empty file would be skipped next run.
  if ! sed "s/Day00/Day$NN/g" "$template" >"$target"; then
    rm -f "$target"
    die "Couldn't create $target from $template."
  fi
  echo "Created $target"
}

download() {
  # tmp stays global: the EXIT trap reads it after this function returns.
  local url="https://adventofcode.com/$YEAR/day/$day/input" token ua status=0
  local unlock="${YEAR}12$NN"
  if ((now < unlock)); then
    die "Day $day unlocks at $(date -j -f '%Y%m%d %H%M %z' "$unlock 0000 -0500" '+%Y-%m-%d %H:%M') local time."
  fi

  # stderr is merged so a failure can be shown; on success the hex check below rejects any noise.
  token=$(security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>&1) || status=$?
  # 44: item not found. Other failures (access denied, locked keychain) need their own message.
  if ((status == 44)); then
    die "No AoC session cookie in the Keychain. Copy the 'session' cookie from adventofcode.com, then run:
  security add-generic-password -U -s $KEYCHAIN_SERVICE -a \"\$USER\" -w"
  elif ((status != 0)); then
    die "Reading the Keychain item '$KEYCHAIN_SERVICE' failed: $token"
  fi
  # Anything but hex could inject extra header lines.
  if ! [[ $token =~ ^[0-9a-f]+$ ]]; then
    die "The Keychain item '$KEYCHAIN_SERVICE' isn't a hex session cookie."
  fi

  ua=$REPO_ID
  if [[ -n ${AOC_CONTACT:-} ]]; then
    if [[ $AOC_CONTACT == *[[:cntrl:]]* ]]; then die "AOC_CONTACT must not contain control characters."; fi
    ua+=" by $AOC_CONTACT"
  fi

  # Outside Sources/Data, which gets bundled.
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' EXIT
  # The cookie goes in on stdin (printf is a builtin) to keep it out of the process list.
  if ! printf 'Cookie: session=%s\n' "$token" |
    curl --silent --show-error --fail-with-body --header @- --user-agent "$ua" \
      --output "$tmp" "$url"; then
    cat "$tmp" >&2
    die "Downloading $url failed."
  fi
  mv "$tmp" "$input"
  echo "Downloaded $input"
}

if (($# > 1)); then
  usage >&2
  exit 2
fi
case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  --register)
    register
    exit 0
    ;;
esac

now=$(TZ=America/New_York date +%Y%m%d)
if (($# == 1)); then
  if ! [[ $1 =~ ^[0-9]{1,2}$ ]]; then die "Day must be a number from 1 to $LAST_DAY, got '$1'."; fi
  # 10# so "08" and "09" aren't read as octal.
  day=$((10#$1))
else
  if [[ ${now:0:4} != "$YEAR" || ${now:4:2} != 12 ]]; then
    die "It's not December $YEAR in AoC's time zone yet, so pass a day."
  fi
  day=$((10#${now:6:2}))
fi
if ((day < 1 || day > LAST_DAY)); then die "Day must be from 1 to $LAST_DAY, got $day."; fi
NN=$(printf %02d "$day")
input="Sources/Data/Day$NN.txt"

# Download first: every registered day loads its input at startup, so a day without one
# would break `swift run` for all days.
if [[ -e $input ]]; then
  echo "Skipped $input (exists)"
else
  download
fi
scaffold Sources/Day00.swift "Sources/Day$NN.swift"
scaffold Tests/Day00.swift "Tests/Day$NN.swift"
register
